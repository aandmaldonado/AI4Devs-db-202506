// Prisma schema expanded for full recruitment flow
// Based on ERD and best practices for PostgreSQL

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int     @id @default(autoincrement()) @map("id")
  name  String  @unique @db.VarChar(100) @map("name")
  employees Employee[]
  @@map("role")
}

model Status {
  id    Int     @id @default(autoincrement()) @map("id")
  name  String  @unique @db.VarChar(50) @map("name")
  positions Position[]
  applications Application[]
  @@map("status")
}

model EmploymentType {
  id    Int     @id @default(autoincrement()) @map("id")
  name  String  @unique @db.VarChar(100) @map("name")
  positions Position[]
  @@map("employment_type")
}

model Location {
  id    Int     @id @default(autoincrement()) @map("id")
  name  String  @unique @db.VarChar(255) @map("name")
  positions Position[]
  @@map("location")
}

model Benefit {
  id    Int     @id @default(autoincrement()) @map("id")
  name  String  @unique @db.VarChar(100) @map("name")
  positions PositionBenefit[]
  @@map("benefit")
}

model Company {
  id          Int        @id @default(autoincrement()) @map("id")
  name        String     @db.VarChar(255) @map("name")
  description String?    @map("description")
  employees   Employee[]
  positions   Position[]
  @@map("company")
}

model Employee {
  id         Int       @id @default(autoincrement()) @map("id")
  companyId  Int       @map("company_id")
  roleId     Int       @map("role_id")
  name       String    @db.VarChar(255) @map("name")
  email      String    @unique @db.VarChar(255) @map("email")
  isActive   Boolean   @default(true) @map("is_active")
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id])
  interviews Interview[]
  @@index([companyId])
  @@index([roleId])
  @@map("employee")
}

model InterviewFlow {
  id          Int             @id @default(autoincrement()) @map("id")
  description String          @db.VarChar(255) @map("description")
  positions   Position[]
  steps       InterviewStep[]
  @@map("interview_flow")
}

model Position {
  id                  Int             @id @default(autoincrement()) @map("id")
  companyId           Int             @map("company_id")
  interviewFlowId     Int             @map("interview_flow_id")
  employmentTypeId    Int             @map("employment_type_id")
  statusId            Int             @map("status_id")
  locationId          Int             @map("location_id")
  title               String          @db.VarChar(255) @map("title")
  description         String?         @map("description")
  isVisible           Boolean         @default(true) @map("is_visible")
  jobDescription      String?         @map("job_description")
  requirements        String?         @map("requirements")
  responsibilities    String?         @map("responsibilities")
  salaryMin           Decimal?        @db.Decimal(12,2) @map("salary_min")
  salaryMax           Decimal?        @db.Decimal(12,2) @map("salary_max")
  applicationDeadline DateTime?       @map("application_deadline")
  contactInfo         String?         @db.VarChar(255) @map("contact_info")
  company             Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  interviewFlow       InterviewFlow   @relation(fields: [interviewFlowId], references: [id], onDelete: Restrict)
  employmentType      EmploymentType  @relation(fields: [employmentTypeId], references: [id])
  status              Status          @relation(fields: [statusId], references: [id])
  location            Location        @relation(fields: [locationId], references: [id])
  applications        Application[]
  benefits            PositionBenefit[]
  @@index([companyId])
  @@index([interviewFlowId])
  @@index([employmentTypeId])
  @@index([statusId])
  @@index([locationId])
  @@map("position")
}

model PositionBenefit {
  positionId Int @map("position_id")
  benefitId  Int @map("benefit_id")
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  benefit    Benefit  @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  @@id([positionId, benefitId])
  @@map("position_benefit")
}

model InterviewType {
  id          Int             @id @default(autoincrement()) @map("id")
  name        String          @db.VarChar(100) @map("name")
  description String?         @map("description")
  steps       InterviewStep[]
  @@map("interview_type")
}

model InterviewStep {
  id               Int             @id @default(autoincrement()) @map("id")
  interviewFlowId  Int             @map("interview_flow_id")
  interviewTypeId  Int             @map("interview_type_id")
  name             String          @db.VarChar(100) @map("name")
  orderIndex       Int             @map("order_index")
  interviewFlow    InterviewFlow   @relation(fields: [interviewFlowId], references: [id], onDelete: Cascade)
  interviewType    InterviewType   @relation(fields: [interviewTypeId], references: [id], onDelete: Restrict)
  interviews       Interview[]
  @@index([interviewFlowId])
  @@index([interviewTypeId])
  @@map("interview_step")
}

model Candidate {
  id          Int           @id @default(autoincrement()) @map("id")
  firstName   String        @db.VarChar(100) @map("first_name")
  lastName    String        @db.VarChar(100) @map("last_name")
  email       String        @unique @db.VarChar(255) @map("email")
  phone       String?       @db.VarChar(15) @map("phone")
  address     String?       @db.VarChar(100) @map("address")
  applications Application[]
  @@map("candidate")
}

model Application {
  id              Int           @id @default(autoincrement()) @map("id")
  positionId      Int           @map("position_id")
  candidateId     Int           @map("candidate_id")
  statusId        Int           @map("status_id")
  applicationDate DateTime      @default(now()) @map("application_date")
  notes           String?       @map("notes")
  position        Position      @relation(fields: [positionId], references: [id], onDelete: Cascade)
  candidate       Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status          Status        @relation(fields: [statusId], references: [id])
  interviews      Interview[]
  @@index([positionId])
  @@index([candidateId])
  @@index([statusId])
  @@map("application")
}

model Interview {
  id               Int            @id @default(autoincrement()) @map("id")
  applicationId    Int            @map("application_id")
  interviewStepId  Int            @map("interview_step_id")
  employeeId       Int?           @map("employee_id")
  interviewDate    DateTime       @map("interview_date")
  result           String?        @db.VarChar(50) @map("result")
  score            Int?           @map("score")
  notes            String?        @map("notes")
  application      Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewStep    InterviewStep  @relation(fields: [interviewStepId], references: [id], onDelete: Restrict)
  employee         Employee?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  @@index([applicationId])
  @@index([interviewStepId])
  @@index([employeeId])
  @@map("interview")
} 